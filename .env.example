APP_NAME="Libro de Trayectos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: SQLite. Producción (Neon/Supabase): DB_CONNECTION=pgsql + DB_URL
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/trayectos?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="trayectos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── APIs externas (todas gratuitas y sin tarjeta) ──────────────────────────
# OpenRouteService: alta gratuita en https://openrouteservice.org/dev/
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_PROFILE=driving-car
ORS_DAILY_QUOTA=1900

# Open Topo Data: sin clave. Máx. 100 puntos/petición, 1 req/s, 1000 req/día
OPENTOPODATA_BASE_URL=https://api.opentopodata.org
OPENTOPODATA_DATASET=eudem25m

# MITECO / Geoportal de Gasolineras: sin clave
MITECO_BASE_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes
# Provincias a sincronizar (ids del Ministerio). Vacío = todas (descarga grande)
MITECO_PROVINCES=29

# Red Eléctrica (PVPC) para vehículos eléctricos: sin clave
REE_BASE_URL=https://apidatos.ree.es
# Precio de respaldo del kWh cuando REE no responde (€/kWh)
DEFAULT_KWH_PRICE=0.15

# Token compartido con el cron de GitHub Actions (lo genera Render con generateValue: true)
INTERNAL_TASK_TOKEN=

VITE_APP_NAME="${APP_NAME}"
